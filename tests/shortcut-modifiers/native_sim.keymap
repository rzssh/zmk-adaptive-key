#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/kscan_mock.h>

/ {
    behaviors {
        corrected: corrected {
            compatible = "zmk,behavior-adaptive-key";
            #binding-cells = <0>;
            bindings = <&kp D>;
            input-key = <D>;

            swap {
                trigger-keys = <S LS(S) RS(S) LS(RS(S))>;
                bindings = <&kp C>;
                max-prior-idle-ms = <1000>;
                strict-modifiers;
                continue-swap;
                continue-shift;
                swap-key = <C>;
            };
        };

        loose: loose {
            compatible = "zmk,behavior-adaptive-key";
            #binding-cells = <0>;
            bindings = <&kp D>;

            swap {
                trigger-keys = <S>;
                bindings = <&kp C>;
                max-prior-idle-ms = <1000>;
            };
        };
    };

    keymap {
        compatible = "zmk,keymap";
        default_layer {
            bindings = <
                &kp S &corrected &kp SPACE &kp LSHFT
                &kp LCTRL &kp RCTRL &kp LALT &kp RALT
                &kp LGUI &kp RGUI &sk LCTRL &loose
            >;
        };
    };
};

&kscan {
    rows = <3>;
    columns = <4>;
    events = <
        ZMK_MOCK_PRESS(0,0,10) ZMK_MOCK_RELEASE(0,0,10)
        ZMK_MOCK_PRESS(0,1,10) ZMK_MOCK_RELEASE(0,1,10)
        ZMK_MOCK_PRESS(0,2,10) ZMK_MOCK_RELEASE(0,2,10)

        ZMK_MOCK_PRESS(0,0,10) ZMK_MOCK_RELEASE(0,0,10)
        ZMK_MOCK_PRESS(1,0,10)
        ZMK_MOCK_PRESS(0,1,10) ZMK_MOCK_RELEASE(0,1,10)
        ZMK_MOCK_RELEASE(1,0,10)
        ZMK_MOCK_PRESS(0,1,10) ZMK_MOCK_RELEASE(0,1,10)
        ZMK_MOCK_PRESS(0,2,10) ZMK_MOCK_RELEASE(0,2,10)

        ZMK_MOCK_PRESS(0,0,10) ZMK_MOCK_RELEASE(0,0,10)
        ZMK_MOCK_PRESS(1,1,10)
        ZMK_MOCK_PRESS(0,1,10) ZMK_MOCK_RELEASE(0,1,10)
        ZMK_MOCK_RELEASE(1,1,10)
        ZMK_MOCK_PRESS(0,1,10) ZMK_MOCK_RELEASE(0,1,10)
        ZMK_MOCK_PRESS(0,2,10) ZMK_MOCK_RELEASE(0,2,10)

        ZMK_MOCK_PRESS(0,0,10) ZMK_MOCK_RELEASE(0,0,10)
        ZMK_MOCK_PRESS(1,2,10)
        ZMK_MOCK_PRESS(0,1,10) ZMK_MOCK_RELEASE(0,1,10)
        ZMK_MOCK_RELEASE(1,2,10)
        ZMK_MOCK_PRESS(0,1,10) ZMK_MOCK_RELEASE(0,1,10)
        ZMK_MOCK_PRESS(0,2,10) ZMK_MOCK_RELEASE(0,2,10)

        ZMK_MOCK_PRESS(0,0,10) ZMK_MOCK_RELEASE(0,0,10)
        ZMK_MOCK_PRESS(1,3,10)
        ZMK_MOCK_PRESS(0,1,10) ZMK_MOCK_RELEASE(0,1,10)
        ZMK_MOCK_RELEASE(1,3,10)
        ZMK_MOCK_PRESS(0,1,10) ZMK_MOCK_RELEASE(0,1,10)
        ZMK_MOCK_PRESS(0,2,10) ZMK_MOCK_RELEASE(0,2,10)

        ZMK_MOCK_PRESS(0,0,10) ZMK_MOCK_RELEASE(0,0,10)
        ZMK_MOCK_PRESS(2,0,10)
        ZMK_MOCK_PRESS(0,1,10) ZMK_MOCK_RELEASE(0,1,10)
        ZMK_MOCK_RELEASE(2,0,10)
        ZMK_MOCK_PRESS(0,1,10) ZMK_MOCK_RELEASE(0,1,10)
        ZMK_MOCK_PRESS(0,2,10) ZMK_MOCK_RELEASE(0,2,10)

        ZMK_MOCK_PRESS(0,0,10) ZMK_MOCK_RELEASE(0,0,10)
        ZMK_MOCK_PRESS(2,1,10)
        ZMK_MOCK_PRESS(0,1,10) ZMK_MOCK_RELEASE(0,1,10)
        ZMK_MOCK_RELEASE(2,1,10)
        ZMK_MOCK_PRESS(0,1,10) ZMK_MOCK_RELEASE(0,1,10)
        ZMK_MOCK_PRESS(0,2,10) ZMK_MOCK_RELEASE(0,2,10)

        ZMK_MOCK_PRESS(0,3,10)
        ZMK_MOCK_PRESS(0,0,10) ZMK_MOCK_RELEASE(0,0,10)
        ZMK_MOCK_PRESS(0,1,10) ZMK_MOCK_RELEASE(0,1,10)
        ZMK_MOCK_RELEASE(0,3,10)
        ZMK_MOCK_PRESS(0,2,10) ZMK_MOCK_RELEASE(0,2,10)

        ZMK_MOCK_PRESS(0,0,10) ZMK_MOCK_RELEASE(0,0,10)
        ZMK_MOCK_PRESS(2,2,10) ZMK_MOCK_RELEASE(2,2,10)
        ZMK_MOCK_PRESS(0,1,10) ZMK_MOCK_RELEASE(0,1,10)
        ZMK_MOCK_PRESS(0,2,10) ZMK_MOCK_RELEASE(0,2,10)

        ZMK_MOCK_PRESS(0,0,10) ZMK_MOCK_RELEASE(0,0,10)
        ZMK_MOCK_PRESS(1,0,10)
        ZMK_MOCK_PRESS(2,3,10) ZMK_MOCK_RELEASE(2,3,10)
        ZMK_MOCK_RELEASE(1,0,10)
    >;
};
